# Alexandria example configuration.
# Copy this file to config.toml and adjust as needed. Most keys can also be set
# through an environment variable named ALEXANDRIA_<SECTION>_<KEY> (e.g.
# ALEXANDRIA_HTTP_PORT, ALEXANDRIA_AUTH_MODE). Two keys depart from that:
# `auth.local_db` has no override at all, and `logging.level` is read from
# ALEXANDRIA_LOG_LEVEL rather than ALEXANDRIA_LOGGING_LEVEL. Unknown keys are
# ignored. This file lists every key the
# server reads — see the Operations & Infrastructure Document §4 for the
# authoritative table.

[auth]
# The single active authentication mode. One of: "external", "local", "windows".
mode = "external"

# External mode only: the HS256 secret Heimdall signs its tokens with — the
# same value as Heimdall's own HEIMDALL_AUTH_TOKEN_SECRET. Required in external
# mode: Heimdall publishes no key set, so this is the only way to verify one of
# its tokens. Prefer the ALEXANDRIA_AUTH_HEIMDALL_TOKEN_SECRET environment
# variable, so a signing key need never be written to disk. Ignored when
# mode = "local".
heimdall_token_secret = ""

# External mode only: the secret Heimdall is rotating away from (its
# HEIMDALL_AUTH_TOKEN_SECRET_PREVIOUS). Tokens signed with either secret are
# accepted, so a rotation on the Heimdall side does not black out Alexandria.
# Ignored when equal to heimdall_token_secret.
heimdall_token_secret_previous = ""

# External mode only: the UUID of the Heimdall scope Alexandria is registered
# in. A token is accepted when it names this scope — as the scope its holder
# belongs to, or as one of the scopes they own. Required in external mode.
heimdall_scope_id = ""

# External mode only: the issuer and audience to require, each checked only
# when set. Heimdall leaves both empty by default and then signs tokens
# carrying neither, so requiring them unconditionally would reject every token
# from a default install.
heimdall_issuer = ""
heimdall_audience = ""

# Local mode only: indicates local-login credentials are managed in the SQLite
# database. Set credentials once via the local credential setup operation (UC-35)
# before callers can authenticate. Ignored when mode = "external".
local_db = false

# Local mode only: how long the session created by a successful local login
# (UC-34) stays valid. Callers present that session id on subsequent requests.
# Ignored when mode = "external".
session_ttl_hours = 24

# Windows mode only: the SID of the account this process must run as. Startup
# fails unless the process is running on Windows as this account. Find it with
# `whoami /user`. Not a secret — it is an identifier, not a credential.
#
# Read what this mode does and does not prove before enabling it: it proves the
# process was launched by this account, never who is calling, so any caller that
# can reach the port is authorized. Keep `http.bind_addr` on loopback.
windows_owner_sid = ""

[http]
# Bind address. Loopback by default so the API is reachable only from the local
# machine unless explicitly reconfigured (see IR-03).
bind_addr = "127.0.0.1"
port = 8080

[database]
# SQLite file path. Bundled beside the desktop app's data directory by default.
path = "alexandria.sqlite"

[filesystem]
# The library root, used for two things. The health check probes it for
# reachability (IR-03), and it bounds indexing: the index operation (UC-01)
# rejects a requested root that is not this path or a descendant of it
# (FR-FC-26). Both paths are canonicalized before the comparison, so `..`
# segments and symlinks cannot slip past it.
#
# Empty — the default — turns both off: the probe reports the filesystem
# unreachable, and indexing is unconstrained, meaning UC-01 will catalog any
# absolute path a caller supplies and the stream operation (UC-38) can then
# read those bytes back. Startup logs a warning while this is unset. The
# re-index operation (UC-02) takes no root and is unaffected either way.
root = ""

[indexing]
# How many files the index (UC-01) and re-index (UC-02) walks process at a
# time. Per-file work is a stat plus, at first index, a tag-header read — never
# a full-file hash (FR-FC-09, FR-FC-10) — and both run on a blocking thread
# pool, so this is real parallelism. The database half of each file's work
# still serializes behind SQLite's single writer and the pool's 8 connections,
# so raising this far above that only lengthens the queue. 0 is treated as 1
# (sequential).
concurrency = 4

# How many files a run started at low priority processes at a time. Low
# priority is for a large scan the owner wants running while they keep
# browsing and playing back, so the default is the narrowest useful width.
# 0 is treated as 1 (sequential), exactly as `concurrency` is.
low_priority_concurrency = 1

[deletion]
# Soft-delete retention window in days. After this many days have elapsed, a
# soft-deleted record becomes eligible for hard purge (default 30, see NFR-10).
retention_days = 30

[logging]
# One of: "error", "warn", "info", "debug", "trace".
level = "info"

[playback]
# Directory holding thumbnails generated by UC-40, created on first use.
# Entries are keyed by the file's UUID and modification time, so a re-index
# that sees a changed mtime invalidates its thumbnail automatically. Keyed on
# the stat pair rather than a content hash for the reason indexing is
# (FR-FC-09): hashing a multi-gigabyte video to decide whether its thumbnail is
# stale would cost more than making the thumbnail. Nothing evicts old entries;
# delete the directory to reclaim the space.
thumbnail_cache_dir = "thumbnails"
